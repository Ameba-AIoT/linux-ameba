/dts-v1/;

#include "rtl8730e.dtsi"
#include "rtl8730e-spi-nand-128m.dtsi"
#include "rtl8730e-drm.dtsi"

/ {
	memory {
		device_type = "memory";
		// DRAM base address should be 1MB-aligned.
		reg = <0x60300000 0x7D00000>;  // 128MB -- exclude 3MB secure memory
	};
	reserved-memory {
		#address-cells = <1>;
		#size-cells = <1>;
		ranges;
		// reserver 32M mem for drm graphics , from 0x61000000 to 0x63000000
		mem_drm_reserved: drm_buffer@0x61000000 {
			compatible = "shared-dma-pool";
			no-map;
			reg = <0x61000000 0x2000000>;
			//linux,cma-default;
		};
	};
};

// Configure peripherals, avoid pinmux conflicts.


&drm {
	status = "okay";
};

&dsi {
	status = "okay";
};

&rtkpanel {
	compatible = "realtek,st7701s";
	pinctrl-names="default";
	pinctrl-0 = <&drm_disable_swd_pins>;
	mipi-gpios = <&gpioa 14 0>;
	status = "okay";
	display-timings {
		native-mode = <&timing0>;
        timing0: timing0 {
			// 480x800 @ 60Hz 2-lanes (typical)
			clock-frequency = <164505600>; // (frame-rate * htotal * vtotal * rgb-bpp) / (2 * lane-num)
			hactive = <480>;
			hfront-porch = <30>;
			hback-porch = <30>;
			hsync-len = <4>;
			vactive = <800>;
			vfront-porch = <15>;
			vback-porch = <20>;
			vsync-len = <5>;
		};
	};
};

&i2c0{
	pinctrl-names = "default";
	pinctrl-0 = <&i2c0_pins>;
	status = "disabled";
};

&i2c1{
	pinctrl-names = "default";
	pinctrl-0 = <&i2c1_pins>;
	status = "disabled";
};

&i2c2{
	#address-cells = <1>;
	#size-cells = <0>;
	pinctrl-names = "default";
	pinctrl-0 = <&i2c2_pins>;
	status = "okay";

	gt9xx@5d {
		compatible = "goodix,gt9xx";
		reg = <0x5d>;
		status = "disabled";
		interrupt-parent = <&gpioa>;
		interrupts = <9 0x2800>;
		pinctrl-names = "default", "int-output-low","int-output-high", "int-input";
		pinctrl-0 = <&ts_int_default>;
		pinctrl-1 = <&ts_int_output_low>;
		pinctrl-2 = <&ts_int_output_high>;
		pinctrl-3 = <&ts_int_input>;

		reset-gpios = <&gpioa 10 0x0>;
		irq-gpios = <&gpioa 9 0x2800>;
		irq-flags = <2>;

		touchscreen-max-id = <11>;
		touchscreen-size-x = <1080>;
		touchscreen-size-y = <1920>;
		touchscreen-max-w = <512>;
		touchscreen-max-p = <512>;
		touchscreen-key-map = <172>, <158>; /* KEY_HOMEPAGE=172, KEY_BACK=158，KEY_MENU=139 */

		goodix,slide-wakeup = <0>;
		goodix,type-a-report = <0>;
		goodix,driver-send-cfg = <0>;
		goodix,resume-in-workqueue = <0>;
		goodix,int-sync = <1>;
		goodix,swap-x2y = <0>;
		goodix,esd-protect = <1>;
		goodix,auto-update-cfg = <0>;
		oodix,auto-update = <0>;
		goodix,power-off-sleep = <0>;
		goodix,pen-suppress-finger = <0>;
		goodix,cfg-group0 = [
			53 D0 02 00 05 05 F5 D5 21 48 2D 0F 5A 41 0E 05 00 00 32 32 20 00 05 14 14 1A 14 8B 2B 00
		];
	};

	rtk_ts@1a {
		compatible = "cst328";
		reg = <0x1a>;
		ts-reset-gpios = <&gpioa 10 0>;
		ts-irq-gpios = <&gpioa 9 0>;
		max-touch-number = <5>;
		ts-display-coords = <480 800>;
		status = "okay";
	};

};

